# Variáveis lidas pelo application.properties (Spring Boot). Não coloque valores reais no Git.
# PowerShell: $env:NOME = 'valor'  antes de  mvn spring-boot:run

# Banco (local, Neon ou Azure). Azure: jdbc:postgresql://SERVIDOR.postgres.database.azure.com:5432/cti_insights?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/cti_insights
DATABASE_USER=cti
DATABASE_PASSWORD=

# JWT (Aula 10). Gere no PowerShell:
#   $bytes = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Fill($bytes)
#   $env:JWT_SECRET_BASE64 = [Convert]::ToBase64String($bytes)
JWT_SECRET_BASE64=
JWT_EXPIRATION_SECONDS=1800
JWT_ISSUER=cti-insights
# true: novos cadastros esperam aprovação do admin (login devolve 403 até lá).
# false: igual ao roteiro de testes da Aula 10 (cadastro 201 -> login 200).
CADASTRO_REQUER_APROVACAO=true

# Integração com o Python (Aula 12)
ETL_URL=http://localhost:8000/etl
ETL_API_KEY=
ETL_TIMEOUT_SECONDS=120

# Domínio publicado do front (CORS) e porta
CORS_ORIGIN=http://localhost:5173
PORT=8080
