# Copie para .env (copy .env.example .env) e preencha. O .env nunca vai para o Git.
# Local (npm start): porta 5433. Neon: DB_HOST=ep-xxxx.sa-east-1.aws.neon.tech e DB_SSLMODE=require.
# Azure: DB_HOST=seu-servidor.postgres.database.azure.com e DB_SSLMODE=require (libere seu IP no firewall).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cti_insights
DB_USER=cti
DB_PASSWORD=
DB_SSLMODE=prefer
# Mesmo valor de ETL_API_KEY no backend (cabeçalho X-ETL-Key). Vazio = sem chave (só para testes locais).
ETL_API_KEY=
