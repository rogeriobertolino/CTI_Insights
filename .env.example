VITE_API_URL=/api/v1
API_PROXY_TARGET=http://127.0.0.1:8080
POSTGRES_PASSWORD=troque-esta-senha

# Obrigatória para JWT no Docker/Maven. Gere 32 bytes aleatórios em Base64.
JWT_SECRET_BASE64=
JWT_EXPIRATION_SECONDS=1800
JWT_ISSUER=cti-insights

# SMTP usado para entregar links de recuperação de senha.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_HEALTH_ENABLED=false
MAIL_FROM=no-reply@cti-insights.local
RESET_PASSWORD_URL=http://localhost:5173/redefinir-senha

# Em Vercel: origem HTTPS do backend, sem /api. Vazio usa proxy local.
VITE_BACKEND_ORIGIN=

# Aula 12: Spring chama o FastAPI (analytics-python/api.py). Mesmo ETL_API_KEY nos dois lados.
ETL_URL=http://localhost:8000/etl
ETL_API_KEY=
ETL_TIMEOUT_SECONDS=120

# Aula 10: false = login liberado logo após o cadastro; true = admin aprova antes.
CADASTRO_REQUER_APROVACAO=true
