VITE_API_URL=/api/v1
API_PROXY_TARGET=http://127.0.0.1:8080
POSTGRES_PASSWORD=troque-esta-senha

# Obrigatória para JWT no Docker/Maven. Gere 32 bytes aleatórios em Base64.
JWT_SECRET_BASE64=
JWT_EXPIRATION_SECONDS=1800
JWT_ISSUER=cti-insights

# Em Vercel: origem HTTPS do backend, sem /api. Vazio usa proxy local.
VITE_BACKEND_ORIGIN=
